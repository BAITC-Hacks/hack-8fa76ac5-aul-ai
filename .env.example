# Application
APP_ENV=local
DEBUG=false
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REQUIRE_ORIGIN=true

# PostgreSQL. Neon production URLs must include sslmode=require.
DATABASE_URL=postgresql://arna:arna@localhost:5432/arna
READINESS_TIMEOUT_SECONDS=3

# Server sessions
SESSION_COOKIE_NAME=arna_session
CSRF_COOKIE_NAME=csrf_token
SESSION_TTL_SECONDS=43200

# OpenRouter. Leave both key and model empty to use FAQ-only mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Arna Logistics
OPENROUTER_SITE_URL=
AI_TIMEOUT_SECONDS=20
AI_MAX_QUESTION_CHARS=1000
AI_MAX_RESPONSE_CHARS=6000
AI_REQUESTS_PER_MINUTE=10

# Public link only. No Telegram bot token belongs in this application.
TELEGRAM_BOT_URL=
